+/*
+ * Prototype switches for the uuid-v7 buffer-pool experiments, read once from
+ * the environment.
+ * MP_ALLOC_DIRTY_CAP=N: once an allocation has visited N buckets, write out a
+ * dirty victim instead of skipping it (0: skip dirty buffers for a full sweep).
+ * MP_ALLOC_UNLOCKED_SCAN=1: search for a victim without the region lock; take
+ * it only to allocate from the region's free memory.
+ */
+static int mp_alloc_dirty_cap;
+static int mp_alloc_unlocked_scan;
+static pthread_once_t mp_alloc_env_once = PTHREAD_ONCE_INIT;
+
+static void
+mp_alloc_read_env(void)
+{
+	const char *v;
+
+	if ((v = getenv("MP_ALLOC_DIRTY_CAP")) != NULL)
+		mp_alloc_dirty_cap = atoi(v);
+	if ((v = getenv("MP_ALLOC_UNLOCKED_SCAN")) != NULL)
+		mp_alloc_unlocked_scan = atoi(v);
+	logmsg(LOGMSG_USER, "mp_alloc prototype: dirty_cap=%d unlocked_scan=%d\n",
+	    mp_alloc_dirty_cap, mp_alloc_unlocked_scan);
+}
